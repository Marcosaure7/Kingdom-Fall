<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="controllers.OptionsController"
             Width="600" Height="400">
    <Border>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text="Nom du joueur :" FontSize="18" VerticalAlignment="Center"/>
                <TextBox x:Name="PlayerNameTextField" Margin="100,0,0,0" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text="Confirmation avant de jeter un objet" FontSize="18" VerticalAlignment="Center"/>
                <CheckBox x:Name="OptConfirmerJeter" Margin="100,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>